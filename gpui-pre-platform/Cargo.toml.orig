[package]
name = "gpui-pre-platform"
version = "0.3.11"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `gpui_platform` crate (gpui-pre snapshot of zed@f816e1f)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "gpui_platform"
zed-version = "0.1.0"
zed-rev = "f816e1f9263e3a8ef63c4baaa02e1441ce1c6038"

[lib]
path = "src/gpui_platform.rs"
doctest = false
name = "gpui_platform"

[features]
default = ["multithreaded"]
multithreaded = ["gpui_web/multithreaded"]
bench-support = ["gpui/bench-support", "gpui_macos/bench-support", "gpui_wgpu/bench-support"]
font-kit = ["gpui_macos/font-kit"]
inspector = ["gpui/inspector"]
test-support = [
    "gpui/test-support",
    "gpui_macos/test-support",
    "gpui_windows/test-support",
    "gpui_wgpu/test-support",
]
screen-capture = [
    "gpui/screen-capture",
    "gpui_macos/screen-capture",
    "gpui_windows/screen-capture",
    "gpui_linux/screen-capture",
]
runtime_shaders = ["gpui_macos/runtime_shaders", "gpui_ios/runtime_shaders"]
wayland = ["gpui_linux/wayland"]
x11 = ["gpui_linux/x11"]

[dependencies]
anyhow = { workspace = true }
gpui = { workspace = true }

[target.'cfg(target_os = "macos")'.dependencies]
gpui_macos = { workspace = true }

[target.'cfg(target_os = "ios")'.dependencies]
gpui_ios = { workspace = true }

[target.'cfg(target_os = "windows")'.dependencies]
gpui_windows = { workspace = true }
gpui = { workspace = true, features = ["windows-manifest"] }

[target.'cfg(all(any(target_os = "linux", target_os = "freebsd"), not(target_env = "ohos")))'.dependencies]
gpui_linux = { workspace = true }

[target.'cfg(target_os = "linux")'.dependencies]
gpui_wgpu = { workspace = true, optional = true }

[target.'cfg(target_family = "wasm")'.dependencies]
gpui_web = { workspace = true }
console_error_panic_hook = { workspace = true }

[lints]
workspace = true

[[bench]]
name = "atlas_upload"
harness = false
required-features = ["bench-support"]

[[bench]]
name = "focus_cleanup"
path = "../gpui/benches/focus_cleanup.rs"
harness = false
required-features = ["bench-support"]

[[bench]]
name = "inspector_render"
harness = false
required-features = ["bench-support"]

[[bench]]
name = "randomized_element_tree"
harness = false
required-features = ["bench-support"]
